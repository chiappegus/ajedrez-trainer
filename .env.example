# Lichess API Configuration (Development Only)
# Copy this file to .env.local and fill in your credentials

# Your Lichess username
VITE_LICHESS_USERNAME=your_username_here

# Your Lichess Personal API Token
# Generate it at: https://lichess.org/account/oauth/token
# Required permissions: Read games
VITE_LICHESS_API_TOKEN=your_token_here

# Groq API Configuration
# Your Groq API Key for AI-powered explanations
# Generate it at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
