{
  "name": "ajedrez-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lichess": "node test-lichess-api.js",
    "copy-stockfish": "node -e \"require('fs').copyFileSync('node_modules/stockfish.js/stockfish.js', 'public/stockfish.js'); require('fs').copyFileSync('node_modules/stockfish.js/stockfish.wasm', 'public/stockfish.wasm'); require('fs').copyFileSync('node_modules/stockfish.js/stockfish.wasm.js', 'public/stockfish.wasm.js'); console.log('✅ Archivos Stockfish copiados a public/')\""
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.2.7",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.7",
    "stockfish.js": "^10.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
